{
  "expo": {
    "name": "Spen",
    "slug": "spen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/spen/logo.svg",
    "scheme": "spen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/spen/logo.svg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F0",
        "foregroundImage": "./assets/spen/adaptive-icon.svg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/spen/logo.svg"
    },
    "splash": {
      "image": "./assets/spen/splash.svg",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F0",
          "image": "./assets/spen/splash.svg",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#12231F",
            "image": "./assets/spen/splash.svg"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
